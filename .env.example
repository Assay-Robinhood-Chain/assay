# ============================================================
# Assay — environment variables
# Copy this file to .env.local (frontend) and set the same
# server-only values as Secrets in Supabase (Edge Functions).
# See README.md > "Environment variables" for where to get each one.
# ============================================================

# --- Supabase (frontend, safe to expose — protected by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Needed here too (not just as a Supabase Edge Function secret) as of
# app/api/admin/moderation/route.ts — set these as server-side env vars
# in Vercel project settings (NOT prefixed NEXT_PUBLIC_, never exposed
# to the browser). Same values you already ran `supabase secrets set`
# with — reuse them, don't generate new ones.
ADMIN_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# --- Supabase (server-only — Edge Functions / migrations. NEVER expose to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Alchemy — RPC self-indexing fallback (Robinhood Chain) ---
# third-party-indexer-integration.md, section 4: "the only fully
# Assay-independent path" — used when a launchpad is NOT in
# DOCUMENTED_LAUNCHPAD_REGISTRY.
ALCHEMY_API_KEY=

# --- Bitquery — launch discovery for documented flagship launchpads ---
BITQUERY_API_KEY=
BITQUERY_DAILY_CALL_BUDGET=4000

# --- Dexscreener — public API, no key required ---
DEXSCREENER_API_BASE_URL=https://api.dexscreener.com
DEXSCREENER_DAILY_CALL_BUDGET=10000

# --- Blockscout — PRO API (requires a free key even on the free tier
# as of the Robinhood Chain launch; old no-key per-instance endpoints
# are deprecated). Get a key at https://dev.blockscout.com ---
BLOCKSCOUT_API_BASE_URL=https://api.blockscout.com
BLOCKSCOUT_API_KEY=
# Robinhood Chain's chain ID for the PRO API path (4663). Only change
# this if pointing at a different chain.
BLOCKSCOUT_CHAIN_ID=4663
BLOCKSCOUT_DAILY_CALL_BUDGET=10000

# --- Mobula — OHLCV history, used to compute each launch's peak-vs-
# launch multiple (the "Value"/"Consistency" score dimensions and the
# token page's "Peak multiple" stat). Get a free key at
# https://admin.mobula.io. Sent as a bare `Authorization: <key>`
# header, not `Bearer <key>`. Without this set, peak_multiple stays
# null (rendered as —) and those two dimensions stay "n/a" — same
# graceful-degradation convention as every other adapter here. ---
MOBULA_API_KEY=
MOBULA_API_BASE_URL=https://api.mobula.io/api/2
# Passed as Mobula's `chainId` query param. Defaults to
# BLOCKSCOUT_CHAIN_ID (4663) if unset — Robinhood Chain isn't one of
# Mobula's documented named chains, so verify this against a real
# token before trusting it for a flagship launchpad.
MOBULA_CHAIN_ID=

# --- Cron / admin security ---
# Generate with: openssl rand -hex 32
CRON_SECRET=
ADMIN_API_KEY=

# --- Error tracking ---
SENTRY_DSN= 

# --- Operational constants (see lib/constants.ts for the frontend mirrors) ---
SNAPSHOT_RETENTION_DAYS=180
DB_BACKUP_RETENTION_DAYS=30
